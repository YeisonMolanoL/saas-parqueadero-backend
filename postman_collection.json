          "name": "Actualizar tarifa",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tarifa estándar actualizada\",\n  \"precioBaseHora\": 2200,\n  \"precioMensualidad\": 85000\n}"
            },
            "url": { "raw": "{{baseUrl}}/tarifas/1", "host": ["{{baseUrl}}"], "path": ["tarifas", "1"] }
          }
        }
      ]
    },
    {
      "name": "Clientes mensuales",
      "item": [
        {
          "name": "Resumen administrativo",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/resumen", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "resumen"] }
          }
        },
        {
          "name": "Listar intenciones de pago",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/clientes-mensuales/intenciones?pagina=1&limite=20",
              "host": ["{{baseUrl}}"],
              "path": ["clientes-mensuales", "intenciones"],
              "query": [ { "key": "pagina", "value": "1" }, { "key": "limite", "value": "20" } ]
            }
          }
        },
        {
          "name": "Listar notificaciones",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/clientes-mensuales/notificaciones?pagina=1&limite=20",
              "host": ["{{baseUrl}}"],
              "path": ["clientes-mensuales", "notificaciones"],
              "query": [ { "key": "pagina", "value": "1" }, { "key": "limite", "value": "20" } ]
            }
          }
        },
        {
          "name": "Reintentar notificación",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/notificaciones/1/reintentar", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "notificaciones", "1", "reintentar"] }
          }
        },
        {
          "name": "Listar clientes mensuales",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/clientes-mensuales?pagina=1&limite=20&busqueda=ABC123&estado=AL_DIA",
              "host": ["{{baseUrl}}"],
              "path": ["clientes-mensuales"],
              "query": [
                { "key": "pagina", "value": "1" },
                { "key": "limite", "value": "20" },
                { "key": "busqueda", "value": "ABC123" },
                { "key": "estado", "value": "AL_DIA" }
              ]
            }
          }
        },
        {
          "name": "Crear cliente mensual",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"XYZ987\",\n  \"nombreCliente\": \"Juan Pérez\",\n  \"tratamiento\": \"SENOR\",\n  \"telefono\": \"573001234567\",\n  \"documentoIdentidad\": \"1234567890\",\n  \"fechaInicioContrato\": \"2026-08-01\",\n  \"diaPagoMensual\": 5,\n  \"metodoPagoInicial\": \"EFECTIVO\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/clientes-mensuales", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales"] }
          }
        },
        {
          "name": "Registrar pago de mensualidad",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodoPago\": \"EFECTIVO\",\n  \"observaciones\": \"Pago puntual\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/1/pagos", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "1", "pagos"] }
          }
        },
        {
          "name": "Listar pagos de un cliente mensual",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/1/pagos", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "1", "pagos"] }
          }
        },
        {
          "name": "Obtener recibo de pago",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/pagos/1/recibo", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "pagos", "1", "recibo"] }
          }
        },
        {
          "name": "Enviar recibo por WhatsApp",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/pagos/1/recibo/enviar", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "pagos", "1", "recibo", "enviar"] }
          }
        },
        {
          "name": "Actualizar cliente mensual",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCliente\": \"Juan Pérez Actualizado\",\n  \"tratamiento\": \"SENOR\",\n  \"telefono\": \"573007654321\",\n  \"documentoIdentidad\": \"1234567890\",\n  \"diaPagoMensual\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/1", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "1"] }
          }
        },
        {
          "name": "Cambiar placa",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placaNueva\": \"NEW001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/1/placa", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "1", "placa"] }
          }
        },
        {
          "name": "Cancelar mensualidad",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Cliente ya no usa el servicio\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/1/cancelar", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "1", "cancelar"] }
          }
        },
        {
          "name": "Reactivar mensualidad",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Cliente retoma el servicio\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/clientes-mensuales/1/reactivar", "host": ["{{baseUrl}}"], "path": ["clientes-mensuales", "1", "reactivar"] }
          }
        }
      ]
    },
