            },
            "url": { "raw": "{{baseUrl}}/turnos/cerrar", "host": ["{{baseUrl}}"], "path": ["turnos", "cerrar"] }
          }
        }
      ]
    },
    {
      "name": "Egresos",
      "item": [
        {
          "name": "Registrar egreso",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monto\": 20000,\n  \"motivo\": \"Compra de tiquetera\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/egresos", "host": ["{{baseUrl}}"], "path": ["egresos"] }
          }
        },
        {
          "name": "Listar egresos por turno",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/egresos/turno/1", "host": ["{{baseUrl}}"], "path": ["egresos", "turno", "1"] }
          }
        }
      ]
    },
    {
      "name": "Tarifas",
      "item": [
        {
          "name": "Obtener tarifa activa",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tarifas/activa", "host": ["{{baseUrl}}"], "path": ["tarifas", "activa"] }
          }
        },
        {
          "name": "Crear tarifa",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tarifa estándar\",\n  \"precioBaseHora\": 2000,\n  \"minutosGracia\": 10,\n  \"horaInicioNocturna\": \"20:00\",\n  \"horaFinNocturna\": \"06:00\",\n  \"tipoRecargoNocturno\": \"PORCENTAJE\",\n  \"valorRecargoNocturno\": 20,\n  \"precioMensualidad\": 80000\n}"
            },
            "url": { "raw": "{{baseUrl}}/tarifas", "host": ["{{baseUrl}}"], "path": ["tarifas"] }
          }
        },
