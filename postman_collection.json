{
  "info": {
    "name": "SaaS Parqueadero Backend",
    "description": "Colección de endpoints de la API. Importa este archivo en Postman o Insomnia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login operario",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parqueaderoId\": 1,\n  \"documentoId\": \"1234567890\",\n  \"pin\": \"1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login-operario", "host": ["{{baseUrl}}"], "path": ["auth", "login-operario"] }
          }
        },
        {
          "name": "Login super admin",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentoId\": \"9999999999\",\n  \"pin\": \"1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login-super-admin", "host": ["{{baseUrl}}"], "path": ["auth", "login-super-admin"] }
          }
        },
        {
          "name": "Perfil (ruta protegida de prueba)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/perfil", "host": ["{{baseUrl}}"], "path": ["auth", "perfil"] }
          }
        }
      ]
    },
    {
      "name": "Entradas",
      "item": [
        {
          "name": "Registrar entrada de moto",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ABC123\",\n  \"telefonoWhatsapp\": \"573001234567\",\n  \"observacionesDanos\": \"Rayón en el tanque\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/entradas", "host": ["{{baseUrl}}"], "path": ["entradas"] }
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Consultar ticket por QR",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/tickets/qr/CODIGO_QR_AQUI", "host": ["{{baseUrl}}"], "path": ["tickets", "qr", "CODIGO_QR_AQUI"] }
          }
        },
        {
          "name": "Registrar salida",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": 1,\n  \"metodoPago\": \"EFECTIVO\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tickets/salida", "host": ["{{baseUrl}}"], "path": ["tickets", "salida"] }
          }
        },
        {
          "name": "Anular ticket",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": 1,\n  \"motivo\": \"Error al registrar la entrada\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tickets/anular", "host": ["{{baseUrl}}"], "path": ["tickets", "anular"] }
          }
        }
      ]
    },
    {
      "name": "Turnos",
